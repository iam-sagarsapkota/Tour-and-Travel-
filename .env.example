# Copy to .env and adjust. Never commit .env. Production secrets are supplied
# by the deployment environment, not by this file.

# --- Django ---
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_DB=tour_travel
POSTGRES_USER=tour_travel
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Only needed when running Django outside Docker (compose sets these itself):
# DATABASE_URL=postgres://tour_travel:change-me@localhost:5432/tour_travel
# REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Bookings ---
BOOKING_HOLD_MINUTES=15
MAX_PARTICIPANTS_PER_BOOKING=20

# --- Email (leave EMAIL_BACKEND empty in development to print emails to the console) ---
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Himalaya Trails <no-reply@example.com>
